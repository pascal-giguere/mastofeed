{
  "name": "mastofeed",
  "version": "1.10.1",
  "description": "A Node.js / TypeScript library to post RSS feed items to Mastodon. Outputs rich, highly-customizable posts.",
  "author": "Pascal Giguère",
  "homepage": "https://github.com/pascal-giguere/mastofeed#readme",
  "license": "GPL-3.0-only",
  "keywords": [
    "mastodon",
    "rss",
    "feed",
    "bot",
    "automation",
    "nodejs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pascal-giguere/mastofeed.git"
  },
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=22",
    "npm": "please-use-yarn",
    "yarn": "4.17.1"
  },
  "main": "dist/index.mjs",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist/",
    "prepack": "yarn run clean && yarn run build",
    "test": "yarn node --experimental-vm-modules $(yarn bin jest) -c ./test/unit/jest.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@pascal-giguere/megalodon": "^10.2.2",
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "dot-prop": "^9.0.0",
    "html-entities": "^2.6.0",
    "rss-parser": "^3.13.0",
    "striptags": "^3.2.0"
  }
}
